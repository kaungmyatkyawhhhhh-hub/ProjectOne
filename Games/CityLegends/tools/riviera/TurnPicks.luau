--[[
	TurnPicks (Studio, Edit mode; 2026-11-04): picks, for each Riviera junction turn, the arc that stays
	on the road. RivieraTraffic builds a turn from a lane's piece to another lane's piece through the
	corner where the two ways meet; by default the nearest pair that has such a corner, which at 23
	corners cut across a kerb or a pavement. Here every turn's path is checked a stud and a half at a
	time, at its middle and 3 studs to each side (a car's width), and where it runs onto a kerb, a
	pavement, an island, a wall or off the road, the other pairs (up to 3 pieces back and 5 on) are
	tried and the one with the fewest bad spots wins (then the nearest). The picks are written to
	src/shared/RivieraTurnPicks.lua (TurnPicks.source), which RivieraTraffic reads.

	TurnPicks.run(g) -> picks, report      (g = a fresh RivieraTraffic.build())
	TurnPicks.source(picks) -> the module's text
]]

local TurnPicks = {}

local EDGE = { Kerb = true, Pavement = true, Island = true, Wall = true, LegWall = true, CurveWall = true }

local function bezier(p0: Vector3, p1: Vector3, p2: Vector3, t: number): Vector3
	local u = 1 - t
	return p0 * (u * u) + p1 * (2 * u * t) + p2 * (t * t)
end

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include
params.RespectCanCollide = false

-- bad spots along the arc p0 -> p1 -> p2
function TurnPicks.score(p0: Vector3, p1: Vector3, p2: Vector3): number
	local riv = workspace:FindFirstChild("Riviera")
	params.FilterDescendantsInstances = { riv, workspace.Terrain }
	local len = (p1 - p0).Magnitude + (p2 - p1).Magnitude
	local n = math.max(4, math.ceil(len / 1.5))
	local bad = 0
	local prev = p0
	for k = 1, n do
		local p = bezier(p0, p1, p2, k / n)
		local d = (p - prev) * Vector3.new(1, 0, 1)
		prev = p
		if d.Magnitude > 0.01 then
			local right = Vector3.new(-d.Z, 0, d.X).Unit
			for _, side in { 0, -3, 3 } do
				local q = p + right * side
				local hit = workspace:Raycast(q + Vector3.new(0, 8, 0), Vector3.new(0, -20, 0), params)
				if not hit or hit.Instance == workspace.Terrain or EDGE[hit.Instance.Name] then
					bad += 1
				end
			end
		end
	end
	return bad
end

function TurnPicks.run(g)
	local picks = {}
	local report = { checked = 0, bad = 0, fixed = 0, better = 0, still = {} }
	for li, link in g.links do
		local fromLane, fromK, toLane, toK = link[1], link[2], link[3], link[4]
		local fl, tl = g.lanesData[fromLane], g.lanesData[toLane]
		if not fl or not tl or fl.skip or tl.skip then
			continue
		end
		local fromN = #fl.pts // 3
		if not fl.closed and (fromK > fromN or (not g.endLinked[fromLane] and fromK >= fromN - 3)) then
			fromK = fromN
		end
		if (fromLane == toLane and toK == 1) or (fl.road == tl.road and fl.way == tl.way) then
			continue -- a loop closing, or a lane change
		end
		local fromRow, toRow = g.rows[fromLane], g.rows[toLane]
		if not (fromRow and toRow and fromRow[fromK - 1] and toRow[toK]) then
			continue
		end
		-- the default pick (as RivieraTraffic does without a pick)
		local defBack, defAhead, defScore = nil, nil, math.huge
		local best = math.huge
		for back = 0, 2 do
			for ahead = 0, 3 do
				local bb, aa = fromRow[fromK - 1 - back], toRow[toK + ahead]
				if bb and aa and back + ahead < best then
					local c = g.corner(bb, aa)
					if c then
						defBack, defAhead, best = back, ahead, back + ahead
					end
				end
			end
		end
		if defBack then
			local bb, aa = fromRow[fromK - 1 - defBack], toRow[toK + defAhead]
			defScore = TurnPicks.score(bb.p2, g.corner(bb, aa), aa.p0)
		end
		report.checked += 1
		if defScore > 0 then
			report.bad += 1
			local pick, pickScore, pickSum = nil, defScore, math.huge
			for back = 0, 3 do
				for ahead = 0, 5 do
					local bb, aa = fromRow[fromK - 1 - back], toRow[toK + ahead]
					if bb and aa then
						local c = g.corner(bb, aa)
						if c then
							local sc = TurnPicks.score(bb.p2, c, aa.p0)
							if sc < pickScore or (sc == pickScore and pick and back + ahead < pickSum) then
								pick, pickScore, pickSum = { back, ahead }, sc, back + ahead
							end
						end
					end
				end
			end
			if pick then
				picks[fromLane .. ":" .. fromK .. ">" .. toLane .. ":" .. toK] = pick
				if pickScore == 0 then
					report.fixed += 1
				else
					report.better += 1
				end
			end
			if not pick or pickScore > 0 then
				local bb = fromRow[fromK - 1]
				table.insert(report.still, string.format("%s -> %s at %.0f,%.0f (%d bad spots left)", fl.road, tl.road, bb.p2.X, bb.p2.Z, if pick then pickScore else defScore))
			end
		end
		if li % 10 == 0 then
			task.wait()
		end
	end
	return picks, report
end

function TurnPicks.source(picks): string
	local keys = {}
	for k in picks do
		table.insert(keys, k)
	end
	table.sort(keys)
	local out = {
		"-- generated by tools/riviera/TurnPicks.luau (Studio): which pieces back and on a junction turn",
		"-- leaves / joins so its arc stays on the road. [\"fromLane:fromK>toLane:toK\"] = { back, ahead }",
		"return {",
	}
	for _, k in keys do
		table.insert(out, string.format('\t["%s"] = { %d, %d },', k, picks[k][1], picks[k][2]))
	end
	table.insert(out, "}")
	return table.concat(out, "\n") .. "\n"
end

return TurnPicks
